<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Large Motors - <%= title %></title>
<link rel="stylesheet" href="/css/mainstyle.css">
</head>
<body<% if (typeof pageClass !== 'undefined' && pageClass) { %> class="<%= pageClass %>"<% } %>>
<!-- — Vehicles of Questionable-Free Quality - -->
<div class="bunting"></div>

<header>
  <div class="logo">LARGE MOTORS</div>
  <div class="tagline">
    <span>Big Lot.</span><span>Big Savings.</span><span>Big Trust.</span> 
  </div>
</header>

<nav>
  <a href="/vehicles">Vehicles</a>
  <a href="/account">Account</a>
  <a href="/blog">News</a>
  <a href="/">Home</a>
  <% if (typeof session !== 'undefined' && session.user && (session.user.role === 'admin' || session.user.role === 'employee')) { %>
    <a href="/contacts">Contacts</a>
    <a href="/services">Service</a>
  <% } %>
  <% if (typeof session !== 'undefined' && session.user && session.user.role === 'admin') { %>
    <a href="/admin">Admin</a>
  <% } %>
  <% if (typeof session !== 'undefined' && session.user) { %>
    <p>Welcome, <%= session.user.username %>! (<a href="/logout">Logout</a>)</p>
  <% } %>
</nav>
