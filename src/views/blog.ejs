<%- include('partials/header') %>

<header>
  <div class="logo">LARGE MOTORS</div>
  <p>Internal Blog — Staff Eyes Only</p>
  <span class="badge-office">DO NOT FORWARD EXTERNALLY</span>
</header>

<main>

  <div class="toolbar">
    <div>
      <h2>Team Updates</h2>
      <div class="sub">blog_posts, with comments threaded from blog_comments. No JavaScript.</div>
    </div>
  </div>

  <details class="new-post-details">
    <summary>New Post</summary>
    <div class="post-form-inner">
      <form method="post" action="/blog">
        <div class="field">
          <label for="p-title">Title</label>
          <input type="text" id="p-title" name="title" required>
        </div>
        <div class="field">
          <label for="p-author">Author</label>
          <input type="hidden" name="author_id" value="<%= session.user.id %>">
        </div>
        <div class="field">
          <label for="p-body">Content</label>
          <textarea id="p-body" name="content" required></textarea>
        </div>
        <div class="form-actions">
          <button type="submit" class="publish-btn">Publish to Team</button>
        </div>
      </form>
    </div>
  </details>

  <div class="post-list" id="post-added">

    <% posts.forEach(function(post) { %>
      <details class="post-card">
        <summary>
          <div class="post-date"><%= post.date.toLocaleString() %></div>
          <div class="post-title"><%= post.title %></div>
          <div class="post-author">Posted by <%= post.author_name %></div>
          <div class="post-excerpt"><%= post.content.substring(0, 100) %>...</div>
          <span class="read-more read-more-closed">▸ Click to read full post + comments</span>
          <span class="read-more read-more-open">▾ Click to collapse</span>
        </summary>

        <div class="post-full"><%= post.content %></div>

        <div class="comments-section">
          <div class="comments-heading">Comments (<%= post.comments.length %>)</div>
          <div class="comment-list">
            <% post.comments.forEach(function(comment) { %>

                <% if (comment.commenter_id === session.user.id) { %>
                  

                  <% if (comment.id == editId) { %>
                    <form class="edit-comment-form" method="post" action="/blog/comments/<%= comment.id %>/edit">
                      <textarea name="comment_text" required><%= comment.comment_text %></textarea>
                      <button type="submit" class="save-changes-btn">Save Changes</button>
                    </form>
                  <% } else { %>
                    <div class="comment-item">
                    <div class="comment-meta"><span><%= comment.commenter_name %></span><span class="comment-date"><%= comment.date.toLocaleString() %></span></div>
                    <div class="comment-body"><%= comment.comment_text %> <br> <a href="/blog/comments/<%= comment.id %>/edit">edit</a> <br><a href="/blog/comments/<%= comment.id %>/delete" onclick="return confirm('Are you sure you want to delete this comment?')">delete</a></div>
                  </div>
                  <% } %>
                <% } else { %>
                  <div class="comment-item">
                    <div class="comment-meta"><span><%= comment.commenter_name %></span><span class="comment-date"><%= comment.date.toLocaleString() %></span></div>
                    <div class="comment-body"><%= comment.comment_text %></div>
                  </div>
                <% } %>
              </div>


              </div>
            <% }); %>
          </div>
          <form class="add-comment-form" method="post" action="/blog/comments">
            <input type="hidden" name="post_id" value="<%= post.id %>">
            <textarea name="comment" placeholder="Add a comment..." required></textarea>
            <button type="submit" class="add-comment-btn">Comment</button>
          </form>
        </div>
      </details>
    <% }); %>

   


  </div>

</main>

<footer>
  Internal Blog — visible to staff only. Please stop screenshotting these and sending
  them to your cousin.
</footer>
