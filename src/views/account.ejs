<%- include('partials/header') %>
<main>
    

<header>
  <p>Welcome back, <%= user.username %></p>
</header>

<main>

  <%
    // This block assumes a flash middleware that exposes messages as
    // `messages.success` / `messages.error` (e.g. express-flash-message's
    // default locals, or connect-flash wired up that way). Adjust the
    // variable names below if your flash middleware exposes them differently.
  %>
  <% const messages = { error: getFlashMessages('error'), success: getFlashMessages('success') }; %>
  <% if (typeof messages !== 'undefined' && messages.error && messages.error.length) { %>
    <div class="status-msg show" style="color:var(--flag-red); display:block; margin-bottom:16px;">
      <% messages.error.forEach(function(msg) { %>⚠ <%= msg %><br><% }) %>
    </div>
  <% } %>
  <% if (typeof messages !== 'undefined' && messages.success && messages.success.length) { %>
    <div class="status-msg show" style="display:block; margin-bottom:16px;">
      <% messages.success.forEach(function(msg) { %>✓ <%= msg %><br><% }) %>
    </div>
  <% } %>

  <h2 class="section-title">Account Details</h2>
  <div class="panel">
    <div class="field-grid" style="margin-bottom:18px;">
      <div class="field">
        <label>Username</label>
        <input type="text" value="<%= user.username %>" disabled>
      </div>
      <div class="field">
        <label>Email</label>
        <input type="text" value="<%= user.email %>" disabled>
      </div>
      <div class="field">
        <label>Role</label>
        <input type="text" value="<%= user.role %>" disabled>
      </div>
    </div>

    <form action="/account/users/<%= user.id %>/password" method="POST">
      <input type="hidden" name="_method" value="PUT">
      <div class="field-grid">
        <div class="field">
          <label for="newPassword">New Password</label>
          <input type="password" id="newPassword" name="newPassword" minlength="6" required>
        </div>
      </div>
      <div class="form-actions">
        <button type="submit" class="submit-btn">Update Password</button>
      </div>
    </form>

    <form action="/logout" method="POST" style="margin-top:14px;">
      <button type="submit" class="reset-btn">Log Out</button>
    </form>
  </div>

  <h2 class="section-title">Request Service</h2>
  <div class="panel">
    <form action="/account/service-requests" method="POST">
      <div class="field-grid">

        <div class="field">
          <label for="vehicle_id">Vehicle</label>
          <select id="vehicle_id" name="vehicle_id" required>
            <option value="" disabled selected>Select a vehicle</option>
            <% vehicles.forEach(function(vehicle) { %>
              <option value="<%= vehicle.id %>"><%= vehicle.year %> <%= vehicle.make %> <%= vehicle.model %> (ID #<%= vehicle.id %>)</option>
            <% }) %>
          </select>
        </div>

        <div class="field">
          <label for="service_type">Service Type</label>
          <select id="service_type" name="service_type" required>
            <option value="" disabled selected>Select a service</option>
            <% serviceRequestTypes.forEach(function(st) { %>
              <option value="<%= st.name %>"><%= st.name %></option>
            <% }) %>
          </select>
        </div>

        <div class="field full">
          <label for="description">Description</label>
          <textarea id="description" name="description" required></textarea>
        </div>

      </div>
      <div class="form-actions">
        <button type="submit" class="submit-btn">Submit Request</button>
      </div>
    </form>
  </div>

  <h2 class="section-title">Your Service Requests</h2>
  <p class="inv-count"><%= serviceRequests.length %> request<%= serviceRequests.length === 1 ? '' : 's' %> on file.</p>

  <div class="inv-table-wrap">
    <table>
      <thead>
        <tr>
          <th>Vehicle</th>
          <th>Service Type</th>
          <th>Status</th>
          <th>Description</th>
          <th>Logged</th>
          <th>Update Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% serviceRequests.forEach(function(sr) { %>
          <tr>

            <% var theVehicle = vehicles.find(v => v.id === sr.vehicle_id); %>



            <td><strong><%= theVehicle.make + ' ' + theVehicle.model + ' (' + theVehicle.year + ')' %></strong></td>
            <td><%= sr.service_type %></td>
            <td><span class="status-pill status-<%= sr.status %>"><%= sr.status %></span></td>
            <td class="row-notes"><%= sr.description || '—' %></td>
            <td><%= new Date(sr.created_at).toLocaleDateString() %></td>
            <td>
              <form action="/account/service-requests/<%= sr.id %>/status" method="POST">
                <div class="request-actions">
                  <select class="status-select" name="newStatus" aria-label="Service request status">
                    <option value="requested" <%= sr.status === 'requested' ? 'selected' : '' %>>Requested</option>
                    <option value="in_progress" <%= sr.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
                    <option value="completed" <%= sr.status === 'completed' ? 'selected' : '' %>>Completed</option>
                    <option value="cancelled" <%= sr.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                  </select>
                  <button type="submit" class="delete-btn" style="border-color:var(--flag-blue); color:var(--flag-blue);">Update</button>
                </div>
              </form>
            </td>
            <td>
              <form action="/account/service-requests/<%= sr.id %>/delete" method="POST">
                <button type="submit" class="delete-btn">Remove</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <% if (serviceRequests.length === 0) { %>
      <div class="empty-state">No service requests yet.</div>
    <% } %>
  </div>

  <h2 class="section-title">Your Messages</h2>
  <p class="inv-count"><%= contacts.length %> message<%= contacts.length === 1 ? '' : 's' %> on file.</p>

  <div class="message-list">
    <% contacts.forEach(function(c) { %>
      <div class="message-card">
        <div class="message-head">
          <div class="message-sender"><%= user.username %></div>
          <div class="message-date"><%= new Date(c.created_at).toLocaleString() %></div>
        </div>
        <p class="message-body"><%= c.message %></p>
      </div>
    <% }) %>
    <% if (contacts.length === 0) { %>
      <div class="empty-state">No messages yet.</div>
    <% } %>
  </div>

   <h2 class="section-title">Send Us a Message</h2>
  <div class="contact-form-panel">
    <form id="contact-form" action="/account/contact" method="POST">
      <input type="hidden" name="user_id" value="<%= user.id %>">
      <div class="field-grid">
        <div class="field full">
          <label for="cmessage">Message</label>
          <textarea id="cmessage" name="message" placeholder="Tell us what's on your mind. We can take it." required></textarea>
        </div>
      </div>
      <div class="form-actions">
        <button type="submit" class="submit-btn">Send Message</button>
      </div>
    </form>
  </div>
</main>



<%- include('partials/footer') %>
