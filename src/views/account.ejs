<main>
    <h1>Account</h1>
    <p>Welcome to your account page! <%= session.user ? session.user.username : 'Guest' %></p>
    email: <%= session.user ? session.user.email : 'Not logged in' %><br>
    role: <%= session.user ? session.user.role : 'Not logged in' %><br>



    <table id="serviceRequests">
        <thead>
            <tr>
                <th>Request ID</th>
                <th>Vehicle ID</th>
                <th>Description</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <% serviceRequests.forEach(function(request) { %>
                <tr>
                    <td><%= request.id %></td>
                    <td><%= request.vehicleId %></td>
                    <td><%= request.description %></td>
                    <td><%= request.status %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>

    <form action="/accounts/service-requests" method="post">
        <input type="text" name="description" id="description">
        <select name="vehicle_id" id="">
            <% vehicles.forEach(function(vehicle) {%>
                <option value='<%= vehicle.id %>'> <%= vehicle.name %></option>
            <% }); %>
        </select>
        <select name="service_type" id=""></select>
        <button type="submit">Submit Request</button>
    </form>
    
    
    
    <a href="/logout">Logout</a>

</main>