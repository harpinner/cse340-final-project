<%- include('partials/header') %>



<body class="page-register">
 
<div class="bunting"></div>
 
<header>
  <div class="logo">LARGE MOTORS</div>
  <p>Create an account to save favorites, track offers, and get first look at the lot</p>
</header>
 
<main>
  <div class="reg-card">
 
    <div class="stamp-corner"><span>NEW ACCOUNT</span></div>
 
    <div class="panel">
   
      <div id="form-view">
        <h2><%%= title %></h2>
        <p class="sub">Takes less time than it takes us to explain that noise the Vandale Wagon makes.</p>
        
        <form id="reg-form" novalidate>
 
          <div class="field">
            <label for="full-name">Full Name</label>
            <input type="text" id="full-name" autocomplete="name" required>
            <div class="error-text" id="err-name"></div>
          </div>
 
          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" autocomplete="email" required>
            <div class="error-text" id="err-email"></div>
          </div>
 
          <div class="field">
            <label for="phone">Phone <span class="hint">(optional, for offer alerts)</span></label>
            <input type="tel" id="phone" autocomplete="tel" placeholder="(555) 555-5555">
            <div class="error-text" id="err-phone"></div>
          </div>
 
          <div class="field">
            <label for="password">Password</label>
            <input type="password" id="password" autocomplete="new-password" required>
            <div class="pw-meter"><div class="pw-meter-fill" id="pw-meter-fill"></div></div>
            <div class="pw-meter-label" id="pw-meter-label">Use 8+ characters</div>
            <div class="error-text" id="err-password"></div>
          </div>
 
          <div class="field">
            <label for="confirm-password">Confirm Password</label>
            <input type="password" id="confirm-password" autocomplete="new-password" required>
            <div class="error-text" id="err-confirm"></div>
          </div>
 
          <div class="checkbox-row">
            <input type="checkbox" id="agree" required>
            <label for="agree">I understand vehicles are sold as-is and I will not be surprised by anything, on principle.</label>
          </div>
 
          <button type="submit" class="submit-btn">Create Account</button>
 
          <p class="form-footer">Already have an account? <a href="#">Log in</a></p>
        </form>
      </div>
 
      <div id="success-view" class="success-panel">
        <div class="big-stamp">APPROVED</div>
        <p>Welcome to Large Motors, <span id="success-name">friend</span>. Your account is
          set up. Check your email for a confirmation link and, eventually, an offer you
          can't refuse-ish.</p>
      </div>
 
    </div>
  </div>
</main>
 
<footer>
  By creating an account you agree to receive occasional emails about vehicles that
  "just came in" and were "definitely not here last week."
</footer>
 
<script>
  const form = document.getElementById('reg-form');
  const formView = document.getElementById('form-view');
  const successView = document.getElementById('success-view');
  const successName = document.getElementById('success-name');
 
  const nameInput = document.getElementById('full-name');
  const emailInput = document.getElementById('email');
  const phoneInput = document.getElementById('phone');
  const pwInput = document.getElementById('password');
  const confirmInput = document.getElementById('confirm-password');
  const agreeInput = document.getElementById('agree');
 
  const errName = document.getElementById('err-name');
  const errEmail = document.getElementById('err-email');
  const errPhone = document.getElementById('err-phone');
  const errPassword = document.getElementById('err-password');
  const errConfirm = document.getElementById('err-confirm');
 
  const pwMeterFill = document.getElementById('pw-meter-fill');
  const pwMeterLabel = document.getElementById('pw-meter-label');
 
  function setError(input, el, msg){
    el.textContent = msg;
    input.setAttribute('aria-invalid', msg ? 'true' : 'false');
  }
 
  function scorePassword(pw){
    let score = 0;
    if(pw.length >= 8) score++;
    if(pw.length >= 12) score++;
    if(/[A-Z]/.test(pw) && /[a-z]/.test(pw)) score++;
    if(/[0-9]/.test(pw)) score++;
    if(/[^A-Za-z0-9]/.test(pw)) score++;
    return score;
  }
 
  pwInput.addEventListener('input', function(){
    const score = scorePassword(pwInput.value);
    const pct = Math.min(100, (score / 5) * 100);
    pwMeterFill.style.width = pct + '%';
 
    let label = 'Use 8+ characters';
    let color = '#c0392b';
 
    if(pwInput.value.length > 0){
      if(score <= 1){ label = 'Weak'; color = '#c0392b'; }
      else if(score <= 3){ label = 'Okay'; color = '#c99e0d'; }
      else { label = 'Strong'; color = '#4c7a3d'; }
    }
 
    pwMeterFill.style.background = color;
    pwMeterLabel.textContent = label;
  });
 
  function validate(){
    let valid = true;
 
    if(nameInput.value.trim().length < 2){
      setError(nameInput, errName, 'Enter your full name.');
      valid = false;
    } else {
      setError(nameInput, errName, '');
    }
 
    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if(!emailPattern.test(emailInput.value.trim())){
      setError(emailInput, errEmail, 'Enter a valid email address.');
      valid = false;
    } else {
      setError(emailInput, errEmail, '');
    }
 
    if(phoneInput.value.trim() && phoneInput.value.trim().replace(/\D/g,'').length < 10){
      setError(phoneInput, errPhone, 'Phone number looks incomplete.');
      valid = false;
    } else {
      setError(phoneInput, errPhone, '');
    }
 
    if(pwInput.value.length < 8){
      setError(pwInput, errPassword, 'Password must be at least 8 characters.');
      valid = false;
    } else {
      setError(pwInput, errPassword, '');
    }
 
    if(confirmInput.value !== pwInput.value || confirmInput.value === ''){
      setError(confirmInput, errConfirm, 'Passwords do not match.');
      valid = false;
    } else {
      setError(confirmInput, errConfirm, '');
    }
 
    if(!agreeInput.checked){
      valid = false;
    }
 
    return valid;
  }
 
  form.addEventListener('submit', function(e){
    e.preventDefault();
    if(!validate()) return;
 
    successName.textContent = nameInput.value.trim().split(' ')[0];
    formView.style.display = 'none';
    successView.classList.add('show');
  });
 
  [nameInput, emailInput, phoneInput, confirmInput].forEach(function(input){
    input.addEventListener('blur', validate);
  });
</script>
 
<-%- include('partials/footer') %>