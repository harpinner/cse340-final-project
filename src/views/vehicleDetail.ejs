<%- include('partials/header') %>

<main>

  <div class="crumb"><a href="/vehicles">Inventory</a> </div>

  <!-- vehicles JOIN categories JOIN vehicle_images (id=1) -->
  <div class="detail-hero">

    <div class="photo-gallery">
      <div class="photo-frame"><img src="<%=vehicle.image_url %>"  alt=""></div>
    </div>

    <div class="info-panel">
      <span class="category-badge"><%= vehicle.category %></span>
      <h1><%= vehicle.year %> <%= vehicle.make %> <%= vehicle.model %></h1>
      <div class="price-line">$<%= Number(vehicle.price).toFixed(2) %></div>

      <p class="vehicle-description">
        <%= vehicle.description %>
      </p>
      <%if (session.user && session.user.role === 'admin' || session.user && session.user.role === 'employee') { %>
        <div class="review">
          <a href="/vehicles/edit/<%= vehicle.id %>/" class="delete-btn edit-link">Edit</a>
        </div>
      <% } %>
     

    </div>
  </div>

  <h2 class="section-title">Customer Reviews</h2>



 <% var totalRating = 0; reviews.forEach(function(review) { totalRating += review.rating; }); var averageRating = totalRating / reviews.length; %>
 <div class="review-summary">
    <div class="review-score"><%= averageRating.toFixed(1) %> / 5</div>
    </div>
    <div>
      <div class="review-stars">
        <% for (let i = 0; i < Math.round(averageRating); i++) { %>
          ★
        <% } %>
        <% for (let i = Math.round(averageRating); i < 5; i++) { %>
          ☆
        <% } %>
      </div>
      <div class="review-count">Based on <%= reviews.length %> reviews</div>
    </div>
  </div>

  <div class="review-list">
<% reviews.forEach(function(review) { %>
    <div class="review">
      <div class="review-head">
        <div class="reviewer"><%=review.username %></div>
        <div class="review-stars-row"><% for (let i = 0; i < review.rating; i++) { %>★<% } %></div>
      </div>
      <div class="review-date"><%=review.review_date %></div>
      <p class="review-body">
      </p>
        <%=review.comment %>
      </p>
      <% if (session.user && session.user.id === review.user_id) { %>
        <form method="post" action="/vehicles/<%= vehicle.id %>/reviews/<%= review.id %>" >
          <input type="hidden" name="_method" value="DELETE">
          <button type="submit" class="contact-btn">Delete</button>
        </form>
      <% } %>
    </div>
<% }); %>

   
  </div>

  <!-- new row into reviews: vehicle_id, user_id, rating, comment -->
   
  <div class="review-form-panel">
    <% if (session.user) { %>
    <h3>Leave a Review</h3>
    <form id="review-form" method="post" action="<%= '/vehicles/' + vehicle.id + '/reviews' %>">
      <input type="hidden" name="userId" value="<%= session.user ? session.user.id : '' %>">
      <input type="hidden" name="vehicleId" value="<%= vehicle.id %>">
      <div class="rf-field">
        <label id="rating-label">Rating</label>
        <fieldset class="star-rating-input" aria-labelledby="rating-label">
          <legend class="sr-only">Star rating</legend>
          <input type="radio" id="star5" name="rating" value="5" required><label for="star5" title="5 stars">★</label>
          <input type="radio" id="star4" name="rating" value="4"><label for="star4" title="4 stars">★</label>
          <input type="radio" id="star3" name="rating" value="3"><label for="star3" title="3 stars">★</label>
          <input type="radio" id="star2" name="rating" value="2"><label for="star2" title="2 stars">★</label>
          <input type="radio" id="star1" name="rating" value="1"><label for="star1" title="1 star">★</label>
        </fieldset>
        <div class="rating-fallback-note">Click a star to set your rating</div>
      </div>
      <div class="rf-field">
        <label for="rtext">Comment</label>
        <textarea id="rtext" name="comment" placeholder="Tell us how it's holding up..." required></textarea>
      </div>
      <button type="submit" class="post-review-btn">Post Review</button>
    </form>  
    <% } else { %>
    <p class="rf-field">Please <a href="/login">log in</a> to leave a review.</p>
  <% } %>
  </div>


</main>

<footer id="reviews-posted">
  Reviews reflect the opinions of individual customers, some of whom we are actively
  in mediation with. Large Motors reserves the right to respond.
</footer>

