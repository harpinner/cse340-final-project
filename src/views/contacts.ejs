<%- include('partials/header') %>

<header>
  <p>Get in touch — we read every message, eventually</p>
</header>

<main>

  

  <h2 class="section-title">Messages</h2>
  <% if (contacts.length > 0) { %>
    <p class="inv-count"><%= contacts.length %> messages on file.</p>
  <% } else { %>
    <p class="inv-count">No messages on file.</p>
  <% } %>

  <div class="message-list" id="message-history">
    <% contacts.forEach(function(contact) { %>
      <div class="message-card">
        <div class="message-head">
          <div class="message-sender"><%= contact.username %></div>
          <div class="message-date"><%= contact.created_at %></div>
        </div>
        <p class="message-body"><%= contact.message %></p>
        <div class="message-sender"><a href="mailto:<%= contact.email %>">Message Back: <%= contact.email %></a></div>
        <div class="message-sender"><a href="/contacts/<%= contact.id %>/delete" class="delete-btn" style="border-color:var(--flag-red); color:var(--flag-red);">Delete</a></div>
      </div>
    <% }); %>
  </div>
</main>


<%- include('partials/footer') %>